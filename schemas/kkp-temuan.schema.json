{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://itjen.komdigi.go.id/schemas/kkp-temuan.schema.json",
  "title": "KKP Temuan — payload untuk inject ke INTEGRAL",
  "description": "Schema array temuan Kertas Kerja Pengawasan, satu file per penugasan. Auditor INTEGRAL mengonsumsi file ini untuk insert ke modul Temuan.",
  "type": "object",
  "required": ["penugasan", "generated_at", "schema_version", "temuan"],
  "properties": {
    "penugasan": {
      "type": "object",
      "required": ["id", "nomor_st", "tanggal_st", "obyek", "jenis_pengawasan"],
      "properties": {
        "id":              { "type": "string", "description": "Slug penugasan, mis. 2026-05-001-reviu-pengadaan-bakti." },
        "nomor_st":        { "type": "string" },
        "tanggal_st":      { "type": "string", "format": "date" },
        "obyek":           { "type": "string", "description": "Auditi / paket pekerjaan." },
        "jenis_pengawasan":{ "type": "string", "enum": [
          "audit-pengadaan", "audit-kinerja",
          "reviu-pengadaan", "reviu-rka-kl",
          "pemantauan-pengadaan", "pemantauan-tindak-lanjut",
          "evaluasi-sakip", "evaluasi-spip", "evaluasi-reformasi-birokrasi", "evaluasi-manajemen-risiko",
          "konsultasi-pengadaan"
        ]}
      },
      "additionalProperties": true
    },
    "generated_at":   { "type": "string", "format": "date-time" },
    "schema_version": { "type": "string", "const": "v4.0.0" },
    "temuan": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/definitions/Temuan" }
    }
  },
  "definitions": {
    "Temuan": {
      "type": "object",
      "required": [
        "id_temuan",
        "sasaran_id",
        "anggota_tim",
        "judul_temuan",
        "kondisi",
        "kriteria",
        "akibat",
        "dokumen_sumber",
        "tanggal_input",
        "status"
      ],
      "properties": {
        "id_temuan": {
          "type": "string",
          "pattern": "^T-[0-9]{3}$",
          "description": "Format T-001, T-002, ... unik per penugasan."
        },
        "sasaran_id": {
          "type": "string",
          "pattern": "^S-[0-9]{2}$",
          "description": "Mengacu ke sasaran di PKP, format S-01..S-99."
        },
        "anggota_tim": {
          "type": "object",
          "required": ["nama_lengkap", "role_kode"],
          "properties": {
            "nama_lengkap": { "type": "string", "minLength": 3 },
            "role_kode":    { "type": "string", "enum": ["AT", "KT", "PT", "PM"] }
          }
        },
        "judul_temuan": {
          "type": "string",
          "minLength": 10,
          "description": "Kalimat deskriptif kondisi (BUKAN label status seperti TERPENUHI)."
        },
        "kondisi": {
          "type": "string",
          "minLength": 30,
          "description": "Fakta yang ditemukan, harus referensi dokumen sumber."
        },
        "kriteria": {
          "type": "string",
          "minLength": 10,
          "description": "Regulasi/SOP yang dilanggar/dipenuhi (sebut nomor & pasal)."
        },
        "sebab": {
          "type": ["string", "null"],
          "description": "Untuk jenis Audit wajib diisi. Untuk Reviu/Pemantauan boleh null."
        },
        "akibat": {
          "type": "string",
          "minLength": 10,
          "description": "Konsekuensi/risiko dari kondisi tsb."
        },
        "dokumen_sumber": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["file"],
            "properties": {
              "file":     { "type": "string", "description": "Nama file di folder _DOKUMEN/." },
              "halaman":  { "type": ["string", "null"], "description": "Halaman / pasal / bagian." },
              "kutipan":  { "type": ["string", "null"], "description": "Kutipan singkat ≤200 karakter (opsional)." }
            },
            "additionalProperties": false
          }
        },
        "tanggal_input": { "type": "string", "format": "date-time" },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "DIREVIU_KETUA_TIM", "DISETUJUI", "DIINJECT_INTEGRAL"],
          "description": "Lifecycle status temuan di sistem v4."
        },
        "catatan_ketua_tim": {
          "type": ["string", "null"],
          "description": "Catatan koreksi dari ketua tim (kalau ada)."
        },
        "kodefikasi_temuan": {
          "type": ["string", "null"],
          "pattern": "^[123]\\.0[1-9]\\.[0-9]{2}$",
          "description": "Kode atribut temuan sesuai PermenPAN 42/2011 Lampiran 2.1. Format X.YY.ZZ. Pilihan dari references/permenpan-42-2011-kode.json (89 kode tersedia). Wajib untuk audit, opsional untuk jenis pengawasan lain."
        },
        "kodefikasi_temuan_reasoning": {
          "type": ["string", "null"],
          "description": "Penjelasan kenapa kode temuan ini yang dipilih (untuk audit trail). Diisi oleh Claude di Task 03 saat memilih kode."
        },
        "kodefikasi_rekomendasi": {
          "type": ["array", "null"],
          "items": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-4])$"
          },
          "description": "Array kode rekomendasi (01-14) sesuai PermenPAN 42/2011 Lampiran 2.2. HARUS subset dari alt_rekomendasi yang valid untuk kodefikasi_temuan terkait."
        },
        "kodefikasi_sebab": {
          "type": ["string", "null"],
          "description": "Kode atribut sebab. Standar enum belum dikonfirmasi tim SIMWAS (pending klarifikasi). Untuk sementara boleh null."
        },
        "integral": {
          "type": ["object", "null"],
          "description": "Diisi otomatis setelah POST sukses ke endpoint /kertas-kerja INTEGRAL via scripts/integral_inject.py.",
          "properties": {
            "id_integral":  { "type": "string", "description": "ID numerik dari response.kertas_kerja.id (atau internal_id sebagai fallback)." },
            "nomor_kkp":    { "type": "string", "description": "Nomor formatted, mis. KKP-1/82/IJ.3/PW.02.06/04/2026 dari response.kertas_kerja.nomor." },
            "tanggal_inject": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "judul_temuan": { "pattern": "^(TERPENUHI|TIDAK TERPENUHI|MEMADAI|TIDAK MEMADAI)" } }
          },
          "then": {
            "errorMessage": "judul_temuan harus deskriptif kondisi, bukan label status."
          }
        }
      ]
    }
  }
}
